rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. User Profiles & Individual User Data
    match /users/{userId} {
      allow read, write: if true;
      
      // Recursive match for all subcollections (chats, facts, memories, data)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 2. Access Keys Collection
    match /access_keys/{keyId} {
      allow read, write: if true;
    }

    // 3. System Configurations & Documents
    match /system/{docId} {
      allow read, write: if true;
    }

    // 4. Fallback for all documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
